#!/usr/bin/env python3
"""MUN developer entry point.

    ./mun get         download and verify a MUN OS development image (no build needed)
    ./mun play        the console in a window, from the latest image (--card collect inserts a card)
    ./mun dev build   build a MUN OS development image for QEMU in a disposable builder
    ./mun dev run     boot an image guest from a build (no network interface)
    ./mun dev vm      operate a guest: cards, keys, screenshots, commands
    ./mun dev shape   preview a MUN Shape package in a laboratory console (--watch follows its changes)
    ./mun dev list    builds and guests
    ./mun dev bundle  make a downloadable bundle of a build (for ./mun get)
    ./mun card        create, inspect and hash Game Card images (tools/mun-card)
    ./mun vm          the QEMU laboratory tool for any console (vm/munvm.py)
    ./mun build       the official image (not available: no hardware configuration is selected)

See README.md and os/README.md.
"""

import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent


def main(argv):
    if argv[:1] == ["dev"]:
        sys.path.insert(0, str(HERE / "vm"))
        import mundev
        return mundev.main(argv[1:])
    if argv[:1] in (["get"], ["play"]):
        sys.path.insert(0, str(HERE / "vm"))
        import mundev
        parser = mundev.get_parser() if argv[0] == "get" else mundev.play_parser()
        return mundev.main(argv[1:], parser)
    if argv[:1] == ["card"]:
        tool = HERE / "tools" / "mun-card" / "mun-card"
        if sys.platform == "win32":
            # execv on Windows starts a new process and returns at once.
            import subprocess
            return subprocess.call([sys.executable, str(tool), *argv[1:]])
        os.execv(sys.executable, [sys.executable, str(tool), *argv[1:]])
    if argv[:1] == ["vm"]:
        sys.path.insert(0, str(HERE / "vm"))
        import munvm
        return munvm.main(argv[1:])
    if argv[:1] == ["build"]:
        # A release image exists only for the one official hardware configuration,
        # which is not selected yet. Never fall back to the QEMU image.
        print("error: the official MUN hardware configuration is not selected yet, so no release image can be "
              "built. `./mun dev build` builds the QEMU development image (release = false).", file=sys.stderr)
        return 2
    print(__doc__.strip())
    return 0 if argv[:1] in ([], ["help"], ["-h"], ["--help"]) else 64


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
