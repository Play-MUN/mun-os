# Development image for a board (profile q6a-dev): the board's audio and
# compute DSPs are started in the initrd, where their firmware is not, and
# stay offline. Start them once the root file system, with the firmware, is
# mounted (usr/lib/mun/board-dsp-start).
[Unit]
Description=Start the board's DSPs with their firmware on disk
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target

[Service]
Type=oneshot
ExecStart=/usr/lib/mun/board-dsp-start

[Install]
WantedBy=sysinit.target
