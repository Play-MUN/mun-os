# mun-launchd: game session supervisor. Root because it starts transient
# systemd units as another user and stops/starts the shell; it needs no mounts
# and no network, touches only /run/mun, and opens one device: the display's
# card, to keep the console's mode from the shell to a game (DisplayHold in
# launchd.py). No capability comes with it: the first to open a card nobody
# is master of becomes master.
[Unit]
Description=MUN game launcher (Game Card session supervisor)
Documentation=file:///opt/mun/launchd/README.md
Requires=run-mun-launch.mount
After=run-mun-launch.mount mun-cardd.service
# If the launcher itself fails, get the shell back regardless.
OnFailure=mun-shell-restore.service
# No start limit. With the default one (five starts in ten seconds) a launcher
# that failed quickly a few times stayed failed until the next boot, and the
# console with it: a removed card no longer ended the game, Play answered
# "unavailable" and safe removal was refused. Whatever made it fail, the
# next start can adopt the running game or bring the shell back.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/mun/launchd/launchd.py
# Always, and after a pause: at most one start a second however it keeps
# ending. Each failed run goes through the failed state before it restarts
# (RestartMode= is left at its default), which is what triggers OnFailure=.
Restart=always
RestartSec=1
# A backstop: the launcher's largest legitimate work (a card's biggest save
# envelope, read and checked) stays under 200 MiB; past this the kernel ends
# it inside its own cgroup, and it restarts as above, instead of the machine
# running short.
MemoryMax=512M
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

# Responsibility-shaped privileges: talk to systemd, own /run/mun/launch.
# CAP_LEASE: a read lease on a save file the game owns is how the launcher
# proves that nothing is writing it at a capture (docs/saves.md).
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_KILL CAP_LEASE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Every device closed but the display's card (in place of PrivateDevices=, which
# would hide it).
DevicePolicy=closed
DeviceAllow=/dev/dri/card0 rw
PrivateNetwork=yes
ReadWritePaths=/run/mun
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
