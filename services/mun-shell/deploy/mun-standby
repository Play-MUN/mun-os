#!/bin/sh
# MUN Shell's standby picture on the display, as early in the boot as the
# image's root is there (mun-standby.service): the shell's own first frame,
# the dark screen with the LED lit (deploy/standby-frame.py made it), written
# to the kernel's framebuffer. It stays until the shell draws the same frame
# itself, a few seconds later, so the console shows MUN instead of black
# while it starts. The shell then clears the framebuffer (src/main.cpp): the
# kernel shows it again whenever no program drives the display, as between
# the shell and a game.
#
# Before the picture, a board's cap on the display link is set (below), so
# that the link is not reconfigured again once the picture shows.
#
# Only a framebuffer of exactly the frame's size and format (1920x1080,
# 32 bits a pixel, 7680 bytes a row) gets it; any other leaves the screen as
# it is. /run/mun-standby/shown tells the shell it was drawn. Never fails
# the boot.
frame=/opt/mun/shell/standby-1920x1080.xrgb
fb=/sys/class/graphics/fb0
shell=/opt/mun/shell/bin/mun-shell

# First, where the unit's environment caps the display link's bits per
# channel (MUN_DISPLAY_MAX_BPC, a board's): the cap, now. Setting it
# reconfigures the link and the display goes dark for a moment; left to the
# shell's start, that moment came with this picture already on screen.
if [ -n "${MUN_DISPLAY_MAX_BPC:-}" ] && [ -x "$shell" ]; then
    "$shell" --cap-display || true
fi

[ -r "$frame" ] || { echo "mun-standby: no standby picture in this image"; exit 0; }
[ -w /dev/fb0 ] || { echo "mun-standby: no framebuffer"; exit 0; }
size=$(cat "$fb/virtual_size" 2>/dev/null)
bits=$(cat "$fb/bits_per_pixel" 2>/dev/null)
stride=$(cat "$fb/stride" 2>/dev/null)
if [ "$size" != 1920,1080 ] || [ "$bits" != 32 ] || [ "$stride" != 7680 ]; then
    echo "mun-standby: the framebuffer is $size, $bits bits a pixel, $stride bytes a row, not the picture's 1920,1080, 32, 7680: nothing shown"
    exit 0
fi
if cat "$frame" >/dev/fb0 2>/dev/null; then
    mkdir -p /run/mun-standby && : >/run/mun-standby/shown
    echo "mun-standby: shown"
else
    echo "mun-standby: the framebuffer refused the picture"
fi
exit 0
