# mun-cardd: Game Card detection, validation and read-only mounting.
# Runs as root because mount(2) needs CAP_SYS_ADMIN, but with the smallest
# footprint systemd can enforce; it never executes card content.
[Unit]
Description=MUN card service (Game Card detection and validation)
Documentation=file:///opt/mun/cardd/README.md
After=systemd-udevd.service local-fs.target
Before=mun-shell.service
# No start limit. With the default one (five starts in ten seconds) a service
# that ended quickly a few times stayed failed until the next boot, and with
# it the console's only reader: no card was seen, no game could start or
# save, and a card could not be released safely. A service that comes back
# reads again the card that is in.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/mun/cardd/cardd.py
# Always, and after a pause: at most one start every two seconds however it
# keeps ending, which cannot keep the processor busy.
Restart=always
RestartSec=2
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# Test hook, off by default: seconds of artificial validation delay.
# Environment=MUN_CARDD_VALIDATION_DELAY=8
# Test hook, off by default: seconds of pause before each chunk of a Shape copy.
# Environment=MUN_CARDD_SHAPE_DELAY=0.5

RuntimeDirectory=mun mun/cards
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

# CAP_DAC_OVERRIDE: saves are written under saves/ on the card, whose directories
# carry whatever ownership the card's author gave them (docs/saves.md).
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/mun
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
DevicePolicy=closed
DeviceAllow=block-blkext rw
DeviceAllow=block-virtblk rw
DeviceAllow=/dev/null rw
# Resource bounds, from the service measured in a QEMU image guest (a MUN OS
# development build, Debian 13, Python 3.13): idle about 34 MiB; a card with
# MUN Shape motion inserted 39 MiB; eight clients that never read 39 MiB; the
# largest valid save the card format allows (an 8 MiB directory save written
# over an earlier one) 156 MiB, 170 MiB with eight such clients at once; four
# tasks at most. MemoryHigh is half again that, so no valid save is slowed;
# MemoryMax ends a service that runs away, which Restart= brings back within
# seconds, its cards read again and a save in flight lost whole (writes are
# atomic: the card keeps its last complete save). tests/test_cardd_unit.py
# keeps these above what was measured, and asks for a new measurement when
# the bounds it was measured with change.
MemoryHigh=256M
MemoryMax=384M
TasksMax=64

[Install]
WantedBy=multi-user.target
