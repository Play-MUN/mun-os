#!/bin/sh
# Development image for a board (profile q6a-dev): route HDMI's output
# (MultiMedia2 to DisplayPort RX 0, PCM 1 of the board's card) once the card
# has loaded its topology from the audio DSP. The card comes some seconds
# after the DSP starts: first the DSP's audio services reach Linux (on the
# GPR bus, a fraction of a second after the DSP is up), then the kernel
# waits 5 s for an answer from the DSP's audio manager that this board's
# DSP never gives, then the card appears.
#
# On some boots (one in seven, 2026-11-13) the DSP starts and opens its
# channels, but none of its services reach Linux: its QRTR link is up and
# carries none of its announcements, so the GPR services, and the card,
# never come. Resetting Linux's end of that link makes the DSP announce them
# again, and the card follows. This script does it once, when the DSP has
# run for `stall` seconds without its services. It waits 40 s in all,
# looking every tenth of a second: the shell's start-up counts the time the
# sound device has played from when it opens it, and until the route is set
# that sound reaches no display.
#
# Every outcome goes to the journal with the time since the kernel started,
# for /usr/lib/mun/board-report: when the card appeared, whether the route
# was already set (the shell's unit starts this again at every shell start)
# or set now. Once it is set, /run/mun-board-audio/route-set says so: a shell
# started with MUN_SHELL_SOUND_READY naming it opens the device only then.
card=QCS6490RadxaDra
link=3700000.remoteproc:glink-edge.IPCRTR.-1.-1
qrtr=/sys/bus/rpmsg/drivers/qcom_smd_qrtr
services=/sys/bus/aprbus/devices/gprsvc:service:2:1
control="name=DISPLAY_PORT_RX_0 Audio Mixer MultiMedia2"
ready=/run/mun-board-audio/route-set
stall=3
steps=400  # of a tenth of a second

since_boot() { cut -d' ' -f1 /proc/uptime; }

dsp_running() {
    for r in /sys/class/remoteproc/remoteproc*; do
        [ "$(cat "$r/name" 2>/dev/null)" = adsp ] && [ "$(cat "$r/state" 2>/dev/null)" = running ] && return 0
    done
    return 1
}

i=0
alone=0     # tenths of a second the DSP has run without its services
reset=no
seen=no
while [ "$i" -lt "$steps" ]; do
    if [ "$seen" = no ] && [ -e "/proc/asound/$card" ]; then
        seen=yes
        echo "the card $card is there at $(since_boot) s"
    fi
    if [ "$seen" = yes ] && amixer -c "$card" cget "$control" 2>/dev/null | grep -q ': values=on'; then
        mkdir -p "${ready%/*}" && : >"$ready"
        echo "HDMI audio route already set at $(since_boot) s"
        exit 0
    fi
    if amixer -q -c "$card" cset "$control" 1 2>/dev/null; then
        mkdir -p "${ready%/*}" && : >"$ready"
        if [ "$reset" = yes ]; then
            echo "HDMI audio route set at $(since_boot) s, after the DSP's link was reset"
        else
            echo "HDMI audio route set at $(since_boot) s"
        fi
        # It must stay set: anything that writes the card's mixer as it
        # appears (a restore of saved state did) can turn it off again, and
        # then every write to the device fails. Looked at twice; set again,
        # and said, if it was turned off.
        for wait in 0.3 1.2; do
            sleep "$wait"
            if ! amixer -c "$card" cget "$control" 2>/dev/null | grep -q ': values=on'; then
                echo "the HDMI audio route was turned off by something else by $(since_boot) s; setting it again" >&2
                amixer -q -c "$card" cset "$control" 1 2>/dev/null || true
            fi
        done
        exit 0
    fi
    if [ -e "$services" ]; then
        alone=0
    elif dsp_running; then
        alone=$((alone + 1))
        if [ "$reset" = no ] && [ "$alone" -ge $((stall * 10)) ]; then
            reset=yes
            echo "the audio DSP ran ${stall} s without its services: resetting Linux's end of its QRTR link at $(since_boot) s"
            echo "$link" >"$qrtr/unbind" 2>/dev/null
            sleep 0.5
            # Unbinding closes the channel; the DSP opens it again and the
            # driver takes it by itself. Bind only if it did not.
            [ -e "/sys/bus/rpmsg/devices/$link/driver" ] || echo "$link" >"$qrtr/bind" 2>/dev/null
        fi
    fi
    i=$((i + 1))
    sleep 0.1
done
echo "the card $card did not appear by $(since_boot) s: no HDMI audio route" >&2
exit 1
